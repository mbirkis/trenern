# trenern app wired to the PostgreSQL container. Use THIS file instead of
# ../trenern.container when running with Postgres. Also install the sibling
# trenern.network, trenern-db.volume and trenern-db.container units.
#
# Create the app env file with a DATABASE_URL whose password matches db.env:
#   mkdir -p ~/.config/trenern
#   echo 'DATABASE_URL=postgres://trenern:THEPASSWORD@trenern-db:5432/trenern' \
#     > ~/.config/trenern/app.env
#   chmod 600 ~/.config/trenern/app.env

[Unit]
Description=trenern – self-hosted treningssporing (Postgres)
After=network-online.target trenern-db.service
Wants=network-online.target
Requires=trenern-db.service

[Container]
Image=localhost/trenern:latest
#Image=trenern.build
ContainerName=trenern
Network=trenern.network
PublishPort=3005:3005
Volume=trenern-data.volume:/app/data
Volume=trenern-config.volume:/app/config
Environment=TZ=Europe/Oslo
Environment=HOST=0.0.0.0
# DATABASE_URL here selects the Postgres backend automatically.
EnvironmentFile=%h/.config/trenern/app.env

HealthCmd=node -e "fetch('http://127.0.0.1:3005/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthStartPeriod=20s

AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
