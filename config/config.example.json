{
  "server": {
    "port": 3005,
    "host": "127.0.0.1"
  },
  "athlete": {
    "birthYear": 1990,
    "maxHr": null,
    "restingHr": 50
  },
  "ingest": {
    "autoOnStart": true,
    "intervalMinutes": 30
