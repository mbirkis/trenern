{
  "server": {
    "port": 3005,
    "host": "127.0.0.1"
  },
  "athlete": {
    "birthYear": 1990,
    "maxHr": null,
    "restingHr": 50
  },
  "ingest": {
    "autoOnStart": true,
    "intervalMinutes": 30
  },
  "storage": {
    "backend": "sqlite",
    "sqlite": {
      "file": "./data/trenern.db"
    },
    "postgres": {
      "url": null
    }
  },
  "map": {
    "tileUrl": "https://tile.tracestrack.com/topo__/{z}/{x}/{y}.png?key={key}",
    "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>-bidragsytere, kartstil &copy; <a href=\"https://www.tracestrack.com/\">Tracestrack</a>",
    "tracestrackKey": "",
    "maxZoom": 19,
    "fallbackTileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "fallbackAttribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>-bidragsytere"
  },
  "sources": [
    {
      "id": "local-sample",
      "type": "localFolder",
      "enabled": true,
      "path": "./data/sample"
    },
    {
      "id": "gdrive-health",
      "type": "googleDrive",
      "enabled": false,
      "folderId": "PUT_GOOGLE_DRIVE_FOLDER_ID_HERE",
      "auth": {
        "method": "serviceAccount",
        "serviceAccountKeyFile": "./config/gdrive-service-account.json",
        "apiKey": null
      },
      "recursive": true,
      "filePattern": "\\.json$"
    },
    {
      "id": "garmin-mitt",
      "type": "garminConnect",
      "enabled": false,
      "label": "Garmin Connect (sett opp via auth-garmin.mjs)"
    }
  ]
}